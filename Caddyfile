# Deployed behind Coolify's Traefik, which already terminates TLS on the host and
# obtains the Let's Encrypt certificate for whatever domain is assigned to this app in
# the Coolify UI. Caddy therefore listens on plain HTTP — no site hostname, no
# automatic-HTTPS/ACME here — Traefik reaches this container over Coolify's internal
# network and Coolify's own port (see docker-compose.yml's `expose: ["80"]`).
:80 {
	encode gzip zstd

	# Staging is not the canonical site — keep it out of search results.
	header X-Robots-Tag "noindex, nofollow"

	# The /api/* reverse proxy to the cache-api container is gone with that service —
	# search and product detail now call the Supabase edge functions directly, the
	# same as production does.

	handle {
		root * /srv

		# This is the actual fix for the "Clear-Site-Data on every load" bug found on
		# production: hashed build assets get real long-lived immutable caching, and
		# nothing here ever purges the browser's cache.
		@hashed {
			path /assets/tradeon-app-*.js /assets/tradeon-chunk-*.js /assets/tradeon-asset-*.* /assets/tradeon-style-*.css /assets/tradeon-live-*.*
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@entry {
			path / /index.html /manifest.webmanifest /favicon.ico /favicon.png /favicon-20260701.png /registerSW.js
		}
		header @entry Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
