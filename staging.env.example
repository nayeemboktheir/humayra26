# Staging environment for the VPS docker-compose stack.
#
#   cp staging.env.example staging.env
#   # then fill in the real values below
#   docker compose --env-file staging.env up -d --build
#
# staging.env holds real secrets — it is gitignored, never commit it.

# --- Same Supabase project the production site uses today (Lovable-managed) ---
# Copy these three values straight out of your local .env — do not retype them.
# Staging reads/writes the SAME database as production: a signup here creates a real
# user, an order here writes a real row. See DEPLOY-STAGING.md before testing checkout.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- cache-api / TMAPI ---
# Same token already used by the Supabase edge functions (Lovable secrets ->
# TMAPI_TOKEN). Get it from there; do not request a second token.
TMAPI_TOKEN=

# The defaults below match cache-api/.env.example and rarely need changing here.
# TMAPI_TIMEOUT_MS=15000
# DETAIL_PAGE_TIMEOUT_MS=4000
# SEARCH_FRESH_MS=604800000
# SEARCH_TTL_SEC=1209600
# PRODUCT_FRESH_MS=43200000
# PRODUCT_TTL_SEC=259200
