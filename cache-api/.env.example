# Copy to cache-api/.env (or set these in the root docker-compose .env — see
# staging.env.example) and fill in the real value. Never commit the real TMAPI_TOKEN.

TMAPI_TOKEN=

# Internal only — Caddy reverse-proxies /api/* to this container, so it is never
# exposed to the public internet directly.
PORT=8787
REDIS_URL=redis://redis:6379

# TMAPI upstream timeouts (ms)
TMAPI_TIMEOUT_MS=15000
DETAIL_PAGE_TIMEOUT_MS=4000

# Cache-aside tuning. FRESH_MS is how long a value is served with no upstream call at
# all; TTL_SEC is the outer bound after which a stale value is no longer served (a true
# miss). See src/cache.js for the stale-while-revalidate behaviour in between.
SEARCH_FRESH_MS=604800000
SEARCH_TTL_SEC=1209600
PRODUCT_FRESH_MS=43200000
PRODUCT_TTL_SEC=259200
