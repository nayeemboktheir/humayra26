  "cards": [
    {
      "dot": "cyan",
      "title": "Endpoints called",
      "items": [
        "/global/search/items, /global/search/keyword",
        "/item_detail",
        "/search/image, /global/search/image/v2",
        "/shop/items, /shop/shop_info, /item/shipping"
      ]
    },
    {
      "dot": "emerald",
      "title": "Call shape",
      "items": [
        "Plain GET, no SDK, no auth header",
        "apiToken query param + language=en",
        "Success needs resp.ok AND body code 200",
        "Detail flow also scrapes 1688 HTML for desc images"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure handling",
      "items": [
        "fetchWithTimeout aborts every upstream call",
        "Network errors return HTTP 200 + retryable",
        "TMAPI_TOKEN read from env, never sent to browser"
      ]
    },
    {
      "dot": "amber",
      "title": "Duplication risk",
      "items": [
        "tmapiMap.js is a hand port of two edge functions",
        "No shared module - sync by hand",
        "server.cjs holds a third /item_detail copy"
      ]
    }
  ]
