.env.*.local

# tsc -b build info (generated by `bun run typecheck`)
*.tsbuildinfo

# Database dumps from the Lovable -> self-hosted migration. These are full
# pg_dump archives of production: every user's bcrypt password hash, emails,
# phone numbers, addresses, orders with payment references, and vault.secrets.
# They must never reach git. Keep them local, delete them when the migration
# is done.
lovable db/
*.backup
*.dump
*.sql.gz

# Frontend env for the self-hosted rehearsal stack (contains the anon key).
.env.selfhost

# Tarball produced when shipping functions to the VPS (see supabase/selfhost/deploy-functions.sh).
functions.tgz
